# --- Meridian app database (server-only; never prefix with VITE_) ---
# The Supabase project that holds MAE Golden Set v0.1 and the public.app_* tables.
MAE_SUPABASE_URL="https://vpehdvjftwxyfkuuvbfs.supabase.co"
# Secret (service_role) key: Supabase → Project Settings → API keys. Server-side only.
MAE_SUPABASE_SECRET_KEY=""

# --- Gemini, for the agent's Diagnoser and Remediator (server-only) ---
# Left empty, the agent still runs: it falls back to rule-backed text and every run
# records provider "deterministic", so nothing is mistaken for model output.
GEMINI_API_KEY=""
# Model ids move. Override here rather than in code. Checked against Google's docs
# on 20 Oct 2026; gemini-3.5-flash-lite is the cheapest, gemini-3.8-flash the strongest.
GEMINI_MODEL="gemini-3.6-flash"

# --- Jira, for the ticket button (server-only) ---
# Left empty, tickets are simulated and labelled as such in the audit trail.
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY=""

# --- Direct Postgres connection, used only by scripts/apply_sql.mjs for DDL ---
DATABASE_URL=""
